{
  "manifest_version": 3,
  "name": "OpenSearch Log Filter Helper",
  "version": "1.6.2",
  "description": "An in-page DQL query editor and inline json_payload field extractor for OpenSearch Dashboards",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Log Filter Helper"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "include_globs": ["*/app/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "include_globs": ["*/app/*"],
      "js": ["suggest-presets.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
