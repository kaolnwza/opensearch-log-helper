{
  "manifest_version": 3,
  "name": "OpenSearch Log Filter Helper",
  "version": "1.9.0",
  "description": "Expand log entries and inject filters for container name / JSON payload in OpenSearch Dashboards",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Log Filter Helper"
  },
  "web_accessible_resources": [
    {
      "resources": ["config/forms.config.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "include_globs": ["*/app/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "include_globs": ["*/app/*"],
      "js": ["dsl-state.js", "suggest-presets.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
